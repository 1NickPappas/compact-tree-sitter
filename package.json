{
  "name": "tree-sitter-compact",
  "version": "0.1.0",
  "description": "A zero-knowledge smart contract programming language",
  "repository": "https://github.com/1NickPappas/compact-tree-sitter",
  "homepage": "https://github.com/1NickPappas/compact-tree-sitter#readme",
  "bugs": "https://github.com/1NickPappas/compact-tree-sitter/issues",
  "license": "Apache",
  "author": {
    "name": "Nick Pappas",
    "url": "https://github.com/1NickPappas"
  },
  "contributors": [
    {
      "name": "Lucas Rosa",
      "email": "lucas.rosa@shielded.io"
    }
  ],
  "compact": {
    "language": "0.23.0",
    "toolchain": "0.31.1",
    "runtime": "0.16.0"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "compact"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "eslint-config-treesitter": "^1.0.2",
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.26.7"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "tree-sitter test",
    "generate": "tree-sitter generate",
    "parse": "tree-sitter parse"
  }
}
